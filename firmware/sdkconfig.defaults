# gpt-live-speaker: Seeed XIAO ESP32-S3 (ESP32-S3R8: 8 MB octal PSRAM, 8 MB QIO flash)
# on the ReSpeaker XVF3800 4-mic array.
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash / partitions --------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- CPU / console -------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# XIAO exposes the S3 native USB (shows up as /dev/cu.usbmodem*)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# GPIO43/44 (UART0) are I2S data lines on this board: no secondary UART console.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- PSRAM (ESP32-S3R8 = octal PSRAM) ------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Anything >= 1 KB goes to PSRAM. Internal RAM is kept for DMA, Wi-Fi, task stacks and tiny allocations
# (was 4096: calls then left only ~20 KB internal free, and AirPlay during calls needs headroom).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- TLS -----------------------------------------------------------------
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Records: full 16 KB in (chatgpt.com sends large Set-Cookie headers), 8 KB out (~4.5 KB Cookie header).
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=8192
# Needed by esp_peer (DTLS-SRTP, self-signed DTLS certificate)
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y

# ---- HTTP client ---------------------------------------------------------
# Per-request rx/tx buffers are set in code (CONFIG_GLS_HTTP_RX_BUF / CONFIG_GLS_HTTP_TX_BUF).
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---- Networking ----------------------------------------------------------
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# internal RAM; dynamic RX buffers go to PSRAM
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# ---- FreeRTOS diagnostics (vTaskList / run-time stats like the esp-webrtc demos) ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# ---- Media (esp_capture / av_render / esp_peer) -----------------------------
# media_lib_sal creates its threads (Opus enc/dec, esp_peer loop) with PSRAM stacks
# via xTaskCreatePinnedToCoreWithCaps; no IDF patch needed on 5.x.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Audio-only: keep esp_capture's video/overlay code out.
CONFIG_ESP_CAPTURE_ENABLE_VIDEO=n
CONFIG_ESP_CAPTURE_ENABLE_VIDEO_OVERLAY=n

# esp_wireguard adds a raw lwIP netif; this makes esp_netif keep its pointer in client_data
# instead of netif->state (otherwise esp_netif dereferences the wireguard state and crashes).
CONFIG_LWIP_PPP_SUPPORT=y

# AirPlay speaker discovery: keep mDNS out of internal RAM (calls leave almost none free)
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# AirPlay during calls: the sender adds 5 sockets (RTSP, event, audio, control, timing) on top of
# WebRTC, HTTPS, the setup server, WireGuard and mDNS; 10 ran out ("Failed to create socket").
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_MAX_UDP_PCBS=24
CONFIG_ESP_WIFI_RX_BA_WIN=8

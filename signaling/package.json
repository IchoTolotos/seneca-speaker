{
  "name": "gpt-live-speaker-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/node.ts",
    "dev:worker": "wrangler dev --port 8788",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.6.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  }
}
